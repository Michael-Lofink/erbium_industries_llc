            },
            {
              "key": "purpose/rail-depot",
              "manual": true
            },
            {
              "key": "purpose/water-trade",
              "manual": true
            }
          ],
          "description": "A major cattle town built around a rail spur, deep well, livestock yard, and seasonal river crossing. Most residents work in freight, repair, water administration, or animal care."
        },
        {
          "id": "agrio-iv-longwater",
          "name": "Longwater Cooperative",
          "type": "facility",
          "metrics": {},
          "tags": [
            {
              "key": "owner/cooperative",
              "manual": true
            },
            {
              "key": "purpose/water-infrastructure",
              "manual": true
            },
            {
              "key": "culture/mutual-aid",
              "manual": true
            }
          ],
          "description": "A locally maintained network of wells, levees, floodgates, and emergency cisterns serving several settlements outside dependable government support.",
          "gmNotes": "The cooperative has evidence that upstream corporate pumping worsens both the dry season and the basin's sudden floods."
        },
        {
          "id": "agrio-iv-charter-house-six",
          "name": "Erbium Charter House Six",
          "type": "facility",
          "metrics": {},
          "tags": [
            {
              "key": "owner/corporation",
              "manual": true
            },
            {
              "key": "purpose/land-registry",
              "manual": true
            },
            {
              "key": "purpose/debt-enforcement",
              "manual": true
            }
          ],
          "description": "A fortified administrative office controlling settlement titles, equipment liens, transport certification, and most recognized water-right records in the central basin.",
          "gmNotes": "After major floods, Charter House Six redraws parcel boundaries from corporate survey data. The settled government recognizes the revised registry even when communities have occupied the land for generations."
        }
      ],
      "description": "The primary inhabited world of the Agrio Dysis system. Its largest settled region, the Low Plane, is a vast hot basin of cattle towns, engineered grazing land, river corridors, rail depots, and scattered refuge communities. The planet is breathable and broadly habitable, but terraforming remains uneven and reliable water is controlled through overlapping local, governmental, and corporate claims.",
      "gmNotes": "Agrio Dysis IV is advertised as a frontier opportunity world. Many residents arrived through relocation programs and inherited transport, equipment, land, or water debt. Erbium rarely governs openly; aligned public authorities enforce the registries and contracts that keep settlements dependent.",
      "autoClassify": true,
      "isNameUserDefined": true
    },
