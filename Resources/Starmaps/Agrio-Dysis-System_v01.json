            {
              "key": "economy/ranching",
              "manual": true
            }
          ],
          "description": "An immense sunken continental basin bordered by broken mountains and dry uplands. Intense heat, long dry seasons, violent storm fronts, and sudden river flooding define most settled life."
        },
        {
          "id": "agrio-iv-crosswind",
          "name": "Crosswind Junction",
          "type": "city",
          "metrics": {},
          "tags": [
            {
